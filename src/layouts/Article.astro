---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  category: { slug: string; name: string };
}

const { title, description, category } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base.replace(/\/$/, '')}${p}`;
---

<Base title={`${title} · Kai Ler Mai`} description={description}>
  <article class="article">
    <div class="wrap">
      <nav class="crumbs">
        <a href={withBase('/')}>Home</a>
        <span>/</span>
        <a href={withBase(`/${category.slug}`)}>{category.name}</a>
        <span>/</span>
        <span class="current">{title}</span>
      </nav>
      <h1 class="article-title">{title}</h1>
      {description && <p class="article-desc">{description}</p>}
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>
