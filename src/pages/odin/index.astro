---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('odin', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title)
);
---

<Base title="The Odin Project · Kai Ler Mai" description="Projects built while studying The Odin Project.">
  <section>
    <div class="wrap">
      <nav class="crumbs"><a href={`${base}/`}>Home</a><span>/</span><span class="current">The Odin Project</span></nav>
      <h1 class="section-title">The Odin Project</h1>
      <p class="section-sub">Projects built while studying The Odin Project.</p>
      <div class="post-list">
        {entries.map((e) => (
          <a class="post-item" href={`${base}/odin/${e.id}`}>
            <h3>{e.data.title}</h3>
            {e.data.description && <p>{e.data.description}</p>}
            {e.data.tags.length > 0 && (
              <div class="tags">{e.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
