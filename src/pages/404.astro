---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404 — Page not found · Mai Kai Ler" description="This page could not be found.">
  <section class="notfound">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page wandered off.</h1>
      <p class="tagline">The page you're looking for doesn't exist or may have moved.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}/`}>Back home</a>
        <a class="btn" href={`${base}/blog`}>Read the blog</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .notfound .wrap {
    width: 100%;
  }
  .notfound .eyebrow {
    font-size: clamp(5rem, 22vw, 14rem);
    line-height: 0.9;
    font-weight: 250;
    letter-spacing: -0.05em;
    margin-bottom: 1.5rem;
  }
  .notfound h1 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .notfound .tagline {
    color: var(--ink-soft);
    margin-bottom: 1.75rem;
  }
</style>
