---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title)
);
---

<Base title="Blog · Mai Kai Ler" description="Thoughts and write-ups from events and projects.">
  <div class="page-top">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={`${base}/`}>Home</a><span>/</span><span class="current">Blog</span></nav>
      <h1 class="page-title">Blog</h1>
    </div>
  </div>
  <section class="band">
    <div class="wrap band-grid">
      <div class="band-head">
        <p class="section-sub">Thoughts and write-ups from events and projects.</p>
      </div>
      <div class="post-list">
        {entries.map((e) => (
          <a class="post-item" href={`${base}/blog/${e.id}`}>
            <h3>{e.data.title}</h3>
            <div class="post-item-text">
              {e.data.description && <p>{e.data.description}</p>}
              {e.data.tags.length > 0 && (
                <div class="tags">{e.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
