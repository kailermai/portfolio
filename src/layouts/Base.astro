---
// Self-hosted variable fonts (no third-party font requests).
import '@fontsource-variable/manrope';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  // Slug of the generated OG image under /og/<ogId>.png (defaults to the site card).
  ogId?: string;
}

const { title = site.name, description = site.tagline, ogId = 'site' } = Astro.props;
// Normalize base so it never has a trailing slash; build URLs as `${base}/path`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = base || '/';
// Absolute URL to the generated OG image (social scrapers require absolute URLs).
const ogImage = new URL(`${base}/og/${ogId}.png`, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Set theme before paint to avoid flash
      const stored = localStorage.getItem('theme');
      const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <div class="shell">
      <nav class="nav" aria-label="Primary">
        <a href={home} class="nav-brand">{site.name}</a>
        <div class="nav-links">
          <a href={`${home}#projects`}>Projects</a>
          <a href={`${home}#education`}>Education</a>
          <a href={`${home}#activities`}>Activities</a>
          <a href={`${base}/blog`}>Blog</a>
          <button class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">Dark</button>
        </div>
      </nav>

      <slot />

      <footer class="footer">
        <p>© {new Date().getFullYear()} {site.name}. Built with Astro.</p>
        <div class="socials">
          {site.socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
        </div>
      </footer>
    </div>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const updateThemeButton = () => {
        const isLight = root.getAttribute('data-theme') === 'light';
        toggle.textContent = isLight ? 'Dark' : 'Light';
        toggle.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
      };
      updateThemeButton();
      toggle.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateThemeButton();
      });
    </script>

    {/* Analytics — only emitted when a GoatCounter code is configured in site.ts */}
    {site.goatCounterCode && (
      <script
        is:inline
        data-goatcounter={`https://${site.goatCounterCode}.goatcounter.com/count`}
        async
        src="//gc.zgo.at/count.js"
      />
    )}
  </body>
</html>
