---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  category: { slug: string; name: string };
  ogId?: string;
}

const { title, description, category, ogId } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base.replace(/\/$/, '')}${p}`;
---

<Base title={`${title} · Mai Kai Ler`} description={description} ogId={ogId}>
  <main class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={withBase('/')}>Home</a>
      <span>/</span>
      <a href={withBase(`/${category.slug}`)}>{category.name}</a>
      <span>/</span>
      <span class="current">{title}</span>
    </nav>
    <article class="tile article">
      <h1 class="article-title">{title}</h1>
      {description && <p class="article-desc">{description}</p>}
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</Base>
