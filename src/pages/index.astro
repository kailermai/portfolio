---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import {
  site,
  experience,
  education,
  modules,
  certifications,
  activities,
} from '../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Project filter categories, in display order. Only show a filter button for a
// category that actually has projects (keeps the row tidy).
const CATEGORY_ORDER = ['Web', 'Mobile', 'Games', 'Tools', 'Other'] as const;
const usedCategories = CATEGORY_ORDER.filter((c) =>
  projects.some((p) => p.data.category === c)
);

// "CS2106 Introduction to Operating Systems" -> code + name, so codes line up
// in their own column. Entries without a module code are shown as-is.
const splitModule = (mod: string) => {
  const m = mod.match(/^([A-Z]{2,4}\d{4}[A-Z]{0,2})\s+(.*)$/);
  return m ? { code: m[1], name: m[2] } : { code: '', name: mod };
};
---

<Base>
  <!-- Hero -->
  <header class="hero">
    <div class="wrap">
      <p class="eyebrow">Hi, I'm</p>
      <h1>{site.name}</h1>
      <div class="hero-body">
        <p class="role">{site.role}</p>
        <p class="tagline">{site.tagline}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#projects">View my work</a>
          {site.socials.map((s) => (
            <a class="btn" href={s.url} target="_blank" rel="noopener">{s.label}</a>
          ))}
        </div>
      </div>
    </div>
  </header>

  <!-- Experience -->
  <section class="band" id="experience">
    <div class="wrap band-grid">
      <div class="band-head">
        <h2 class="section-title">Experience</h2>
        <p class="section-sub">Where I've worked and what's next.</p>
      </div>
      <ul class="rows rows-3">
        {experience.map((e) => (
          <li class="row">
            <span class="row-title">{e.role}</span>
            <span>{e.org}</span>
            <span class="row-end">{e.period}</span>
            {e.points && (
              <ul class="points row-full">
                {e.points.map((p) => <li>{p}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section class="band" id="projects">
    <div class="wrap band-grid">
      <div class="band-head">
        <h2 class="section-title">Projects</h2>
        <p class="section-sub">Things I've built. Filter by type:</p>
      </div>
      <div>
        <div class="filters" id="project-filters" role="group" aria-label="Filter projects by type">
          <button class="filter-btn is-active" data-filter="all" aria-pressed="true">All</button>
          {usedCategories.map((c) => (
            <button class="filter-btn" data-filter={c} aria-pressed="false">{c}</button>
          ))}
        </div>
        <div class="grid" id="project-grid">
          {projects.map((p) => (
            <article class="card" data-category={p.data.category}>
              <div class="card-heading">
                <h3>{p.data.title}</h3>
                {p.data.image && (
                  <img class="card-img" src={`${base}${p.data.image}`} alt={p.data.title} loading="lazy" />
                )}
              </div>
              <div class="card-text">
                <p class="desc">{p.data.description}</p>
                {p.data.tech.length > 0 && (
                  <div class="tags">
                    {p.data.tech.map((t) => <span class="tag">{t}</span>)}
                  </div>
                )}
                {p.data.links.length > 0 && (
                  <div class="card-links">
                    {p.data.links.map((l) => (
                      <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
        <p class="no-results" id="no-results" hidden>No projects match that filter.</p>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="band" id="education">
    <div class="wrap band-grid">
      <div class="band-head">
        <h2 class="section-title">Education</h2>
        <p class="section-sub">My academic journey and achievements.</p>
      </div>
      <ul class="rows rows-3">
        {education.map((e) => (
          <li class="row">
            <span class="row-title">{e.degree}</span>
            <span>{e.school}</span>
            <span class="row-end">{e.period}</span>
            {e.points && (
              <ul class="points row-full">
                {e.points.map((p) => (
                  <li>{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.text} ↗</a> : p.text}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Modules -->
  <section class="band" id="modules">
    <div class="wrap band-grid">
      <div class="band-head">
        <h2 class="section-title">Coursework</h2>
        <p class="section-sub">Current modules and past coursework at NUS.</p>
      </div>
      <div class="mods-grid">
        {modules.map((m) => (
          <div class:list={['mod-block', { current: m.current }]}>
            <h3>
              {m.semester}
              {m.current && <span class="course-status">Currently taking</span>}
            </h3>
            <ul>
              {m.mods.map((mod) => {
                const { code, name } = splitModule(mod);
                return code ? (
                  <li><span class="mod-code">{code}</span><span>{name}</span></li>
                ) : (
                  <li><span class="mod-name-only">{name}</span></li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="band" id="certifications">
    <div class="wrap band-grid">
      <div class="band-head">
        <h2 class="section-title">Certifications</h2>
        <p class="section-sub">Credentials I've earned.</p>
      </div>
      <ul class="rows rows-3">
        {certifications.map((c) => (
          <li class="row">
            <span class="row-title">
              {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name} ↗</a> : c.name}
            </span>
            <span>{c.issuer}</span>
            <span class="row-end date">{c.date}</span>
            {c.credentialId && <span class="badge row-full">ID: {c.credentialId}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Activities -->
  <section class="band" id="activities">
    <div class="wrap band-grid">
      <div class="band-head">
        <h2 class="section-title">Hackathons, CTFs &amp; Activities</h2>
        <p class="section-sub">Competitions and co-curriculars I've taken part in.</p>
      </div>
      <ul class="rows rows-dated">
        {activities.map((a) => (
          <li class="row">
            <span class="row-soft date">{a.date}</span>
            <span>
              <span class="row-title">{a.name}</span>
              {a.note && <span><br />{a.note}</span>}
            </span>
            {a.links ? (
              <span class="row-links">
                {a.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
              </span>
            ) : <span></span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Blog -->
  <section class="band" id="writing">
    <div class="wrap band-grid">
      <div class="band-head">
        <h2 class="section-title">Blog</h2>
      </div>
      <div>
        <p class="blog-lede">Thoughts and write-ups from events and projects.</p>
        <a class="btn" href={`${base}/blog`}>Read the blog →</a>
      </div>
    </div>
  </section>

  <script is:inline>
    // --- Project tag filtering ---
    (() => {
      const filters = document.getElementById('project-filters');
      const cards = Array.from(document.querySelectorAll('#project-grid .card'));
      const noResults = document.getElementById('no-results');
      if (!filters) return;
      filters.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;
        const filter = btn.dataset.filter;
        filters.querySelectorAll('.filter-btn').forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        let visible = 0;
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.category === filter;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (noResults) noResults.hidden = visible !== 0;
      });
    })();

    // --- Active section highlight in nav ---
    (() => {
      const links = Array.from(document.querySelectorAll('.nav-links a[href*="#"]'));
      if (!links.length) return;
      const map = new Map();
      links.forEach((l) => {
        const id = l.getAttribute('href').split('#')[1];
        const sec = id && document.getElementById(id);
        if (sec) map.set(sec, l);
      });
      if (!map.size) return;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((l) => l.classList.remove('active'));
              map.get(entry.target)?.classList.add('active');
            }
          });
        },
        { rootMargin: '-45% 0px -50% 0px' }
      );
      map.forEach((_, sec) => io.observe(sec));
    })();
  </script>
</Base>
