---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404 — Page not found · Mai Kai Ler" description="This page could not be found.">
  <main class="page">
    <section class="tile notfound">
      <p class="code">404</p>
      <h1>This page wandered off.</h1>
      <p class="tagline">The page you're looking for doesn't exist or may have moved.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}/`}>Back home</a>
        <a class="btn" href={`${base}/blog`}>Read the blog</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .notfound .code {
    font-family: var(--display);
    color: var(--accent-text);
    font-size: 4.5rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }
  .notfound h1 {
    font-family: var(--display);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .notfound .tagline {
    color: var(--text-2);
    font-size: 1.1rem;
    margin-bottom: 28px;
  }
</style>
