---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404 — Page not found · Kai Ler Mai" description="This page could not be found.">
  <section class="notfound">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page wandered off.</h1>
      <p class="tagline">The page you're looking for doesn't exist or may have moved.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}/`}>Back home</a>
        <a class="btn btn-ghost" href={`${base}/blog`}>Read the blog</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .notfound .eyebrow {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .notfound h1 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .notfound .tagline {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 28px;
  }
</style>
